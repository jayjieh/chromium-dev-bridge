<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.cdb</groupId>
    <artifactId>chromium-dev-bridge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Chromium Developer Bridge</name>
    <description>AI-powered Chromium automation and debugging platform with IntelliJ and MCP integrations</description>

    <modules>
        <module>shared-protocol</module>
        <module>browser-core</module>
        <module>playwright-provider</module>
        <module>browser-api</module>
        <module>browser-driver</module>
        <module>mcp-server</module>
        <module>integration-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.65.1</playwright.version>
        <skipITs>false</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.cdb</groupId>
                <artifactId>shared-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.cdb</groupId>
                <artifactId>browser-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.cdb</groupId>
                <artifactId>playwright-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.cdb</groupId>
                <artifactId>browser-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.cdb</groupId>
                <artifactId>browser-driver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <trimStackTrace>false</trimStackTrace>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
