<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.cdb</groupId>
        <artifactId>chromium-dev-bridge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>integration-tests</artifactId>
    <name>CDB :: Integration Tests</name>
    <description>End-to-end tests: real driver + Playwright Chromium + sample app + MCP server</description>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>dev.cdb</groupId>
            <artifactId>browser-driver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.cdb</groupId>
            <artifactId>browser-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.cdb</groupId>
            <artifactId>mcp-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipITs}</skipTests>
                    <environmentVariables>
                        <TEST_EMAIL>qa@example.test</TEST_EMAIL>
                        <TEST_PASSWORD>demo-password</TEST_PASSWORD>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <cdb.sampleApp>${project.basedir}/../sample-applications/login-demo/server.mjs</cdb.sampleApp>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
